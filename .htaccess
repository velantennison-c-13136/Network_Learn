# =============================================================================
# Apache HTTP Server — .htaccess
# Network Learn Atlas (Static Site)
# =============================================================================
# Requires: mod_rewrite, mod_headers, mod_deflate, mod_expires, mod_filter
# Enable modules (Debian/Ubuntu):
#   sudo a2enmod rewrite headers deflate expires filter
#   sudo systemctl reload apache2
# =============================================================================

Options -Indexes -MultiViews +FollowSymLinks
DirectoryIndex index.html

# =============================================================================
# HTTP → HTTPS redirect
# =============================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect www → non-www (optional — swap rules to prefer www instead)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Redirect plain HTTP → HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # SPA / single-page fallback
    # Serve index.html for paths that are not real files or directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /index.html [L]
</IfModule>

# =============================================================================
# Security headers
# =============================================================================
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Frame-Options           "SAMEORIGIN"
    Header always set X-Content-Type-Options    "nosniff"
    Header always set Referrer-Policy           "strict-origin-when-cross-origin"
    Header always set Permissions-Policy        "geolocation=(), microphone=(), camera=()"
    Header always set Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none';"

    # Remove server fingerprinting headers
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# =============================================================================
# Block access to sensitive files
# =============================================================================

# Hidden files (.git, .env, .gitignore, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Source / config files that should never be served publicly
<FilesMatch "\.(md|yml|yaml|lock|nojekyll|gitignore)$">
    Require all denied
</FilesMatch>

# =============================================================================
# MIME types
# =============================================================================
<IfModule mod_mime.c>
    AddType text/css                  .css
    AddType text/javascript           .js
    AddType application/json          .json
    AddType image/svg+xml             .svg
    AddType image/webp                .webp
    AddType font/woff                 .woff
    AddType font/woff2                .woff2
    AddType application/vnd.ms-fontobject .eot
    AddType font/ttf                  .ttf
    AddType font/otf                  .otf
</IfModule>

# =============================================================================
# Gzip / deflate compression
# =============================================================================
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE \
            text/html \
            text/plain \
            text/css \
            text/javascript \
            application/javascript \
            application/json \
            application/xml \
            image/svg+xml \
            font/woff2
    </IfModule>

    # Don't compress already-compressed formats
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|woff2?)$ no-gzip dont-vary
    Header append Vary Accept-Encoding env=!no-gzip
</IfModule>

# =============================================================================
# Browser caching (Expires / Cache-Control)
# =============================================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # Default fallback
    ExpiresDefault                             "access plus 1 month"

    # HTML — always revalidate
    ExpiresByType text/html                    "access plus 0 seconds"

    # CSS and JavaScript — 1 year (use file fingerprinting for cache-busting)
    ExpiresByType text/css                     "access plus 1 year"
    ExpiresByType text/javascript              "access plus 1 year"
    ExpiresByType application/javascript       "access plus 1 year"

    # Fonts — 1 year
    ExpiresByType font/woff                    "access plus 1 year"
    ExpiresByType font/woff2                   "access plus 1 year"
    ExpiresByType font/ttf                     "access plus 1 year"
    ExpiresByType font/otf                     "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

    # Images — 1 year
    ExpiresByType image/png                    "access plus 1 year"
    ExpiresByType image/jpg                    "access plus 1 year"
    ExpiresByType image/jpeg                   "access plus 1 year"
    ExpiresByType image/gif                    "access plus 1 year"
    ExpiresByType image/webp                   "access plus 1 year"
    ExpiresByType image/svg+xml                "access plus 1 year"
    ExpiresByType image/x-icon                 "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon     "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Strip ETags to rely entirely on Cache-Control
    Header unset ETag
    FileETag None

    # Cache-Control per file type
    <FilesMatch "\.(html?)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(css|js|woff2?|ttf|otf|eot|png|jpe?g|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# =============================================================================
# Custom error pages
# =============================================================================
ErrorDocument 400 /index.html
ErrorDocument 403 /index.html
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html
